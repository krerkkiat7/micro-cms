APP_NAME="MicroCMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# โซนเวลาเริ่มต้น — ตั้งค่าระบบ (sys_setting กลุ่ม site, คอลัมน์ timezone) มาก่อนถ้ามีตั้งไว้ (ดู config/app.php)
APP_TIMEZONE=Asia/Bangkok

# ภาษาเริ่มต้นของระบบ (front รองรับ th / en, ดู routes/web.php)
APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# แนะนำ daily (หมุนไฟล์รายวัน) แทน single ที่โตไม่หยุด
LOG_STACK=daily
LOG_DAILY_DAYS=90
# error ที่ถูก report + รหัสอ้างอิง (storage/logs/text-error-*.log + json-error-*.log แยก front/admin) เก็บกี่วัน
LOG_ERROR_DAYS=90
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8+ — ค่าเริ่มต้นตรงกับ docker-compose.yml (service: mysql, DB: my_cms)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=my_cms
DB_USERNAME=root
DB_PASSWORD=root

# Session เก็บบน Redis
SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Cache เก็บบน Redis
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Redis — ค่าเริ่มต้นตรงกับ docker-compose.yml (service: redis, ไม่มีรหัสผ่าน)
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# หน้าบ้าน (config/front.php — docs/PRD-front.md) ค่าเริ่มต้นใช้ได้เลย ไม่ต้องตั้ง
# FRONT_VIEW_DRIVER=auto            # auto | redis | database — ตัวนับยอดเข้าชม (redis ต้องมี cron schedule:run)
# FRONT_VIEW_DEDUPE_MINUTES=5
# FRONT_CACHE_CONTENT_TTL=300
